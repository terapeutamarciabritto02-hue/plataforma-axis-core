{
  "expo": {
    "name": "AXIS CORE™",
    "slug": "axis-core",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#050508"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.axiscore.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada para captura biométrica PPG durante as sessões.",
        "NSMicrophoneUsageDescription": "Não utilizado."
      }
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#050508" },
      "package": "app.axiscore.mobile",
      "permissions": ["CAMERA", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      ["expo-notifications", {
        "icon": "./assets/notification-icon.png",
        "color": "#c8a97e"
      }],
      "react-native-vision-camera"
    ],
    "experiments": { "typedRoutes": true },
    "scheme": "axiscore"
  }
}
