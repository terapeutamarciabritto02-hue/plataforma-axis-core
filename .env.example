# ─────────────────────────────────────────────────────────────
# AXIS CORE™ — Environment Variables
# Copie para .env.local (frontend) e .env (backend)
# NUNCA commite valores reais no repositório
# ─────────────────────────────────────────────────────────────

# ── SUPABASE (público — Next.js) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── SUPABASE (privado — Backend) ──────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── API URL ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
# Em produção: https://axis-core-api.onrender.com

# ── BACKEND ───────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_SECRET_KEY=change-me-min-32-characters-long!!
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost

# ── MQTT (EMQX) ───────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost
MQTT_PORT=1883
MQTT_USERNAME=axis_core
MQTT_PASSWORD=change-me

# ── REDIS (Upstash ou local) ──────────────────────────────────
REDIS_URL=redis://localhost:6379
